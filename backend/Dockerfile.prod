FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install build dependencies and uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.local/bin:$PATH"

# Copy dependency files
COPY pyproject.toml .

# Install dependencies
RUN uv pip install --system -e .

# Install pip-licenses for OSS attribution generation
RUN uv pip install --system pip-licenses

# Generate backend license list
RUN pip-licenses --format=json --output-file=/app/licenses-backend.json

# Build version injection
ARG BUILD_VERSION=dev
ARG BUILD_DATE=
RUN echo "{\"version\": \"${BUILD_VERSION}\", \"buildDate\": \"${BUILD_DATE}\"}" > /app/build-info.json

# ---

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=config.settings.production

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    # WeasyPrint runtime dependencies
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz-subset0 \
    libffi8 \
    libglib2.0-0 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy build-time generated files
COPY --from=builder /app/build-info.json /app/build-info.json
COPY --from=builder /app/licenses-backend.json /app/licenses-backend.json

# Copy application code
COPY . .

# Make entrypoint executable
RUN chmod +x entrypoint.prod.sh

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app

# Collect static files (dummy secret key – only needed to load settings, not used at runtime)
RUN DJANGO_SECRET_KEY=build-placeholder DATABASE_URL=sqlite:///dev/null DJANGO_DEBUG=false \
    python manage.py collectstatic --noinput --settings=config.settings.production

USER appuser

EXPOSE 8000

# Use entrypoint script for migrations
ENTRYPOINT ["./entrypoint.prod.sh"]

# Production command with multiple workers
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "4", "--threads", "2", "--worker-class", "gthread"]
